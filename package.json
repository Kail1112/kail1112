{
  "name": "kail1112",
  "version": "0.0.0",
  "private": true,
  "homepage": "https://github.com/Kail1112/kail1112#readme",
  "bugs": {
    "url": "https://github.com/Kail1112/kail1112/issues"
  },
  "license": "MIT",
  "author": "Mikhail Ifutin",
  "type": "module",
  "bin": {
    "build-package": "./build/build-package/index.js",
    "create-package": "./build/create-package/index.js"
  },
  "scripts": {
    "build": "turbo run build",
    "configure": "pnpm configure:install && pnpm configure:build && pnpm rebuild && pnpm build",
    "configure:build": "shx rm -rf build && swc src --strip-leading-paths -d build",
    "configure:install": "pnpm i",
    "dev": "turbo run dev",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{js,ts}": "eslint --max-warnings 0",
    "*.json": "prettier --write"
  },
  "devDependencies": {
    "@kail1112/eslint-configs": "workspace:^",
    "@swc/cli": "0.7.9",
    "@swc/core": "catalog:",
    "@types/glob-parent": "5.1.3",
    "@types/node": "catalog:",
    "@types/yargs": "17.0.35",
    "dotenv": "catalog:",
    "dotenv-expand": "catalog:",
    "eslint": "catalog:",
    "glob-parent": "5.1.2",
    "globals": "catalog:",
    "husky": "9.1.7",
    "jiti": "2.6.1",
    "kail1112": "link:",
    "lint-staged": "16.2.7",
    "minimatch": "catalog:",
    "prettier": "catalog:",
    "prettier-plugin-packagejson": "2.5.20",
    "prettier-plugin-sort-json": "4.1.1",
    "shx": "0.4.0",
    "turbo": "2.7.2",
    "typescript": "catalog:",
    "yaml": "catalog:",
    "yargs": "catalog:"
  },
  "packageManager": "pnpm@10.27.0",
  "engines": {
    "node": ">=20",
    "npm": ">=10",
    "pnpm": ">=10"
  }
}
